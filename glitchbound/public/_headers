/assets/*
  Cache-Control: public, max-age=31536000, immutable

/games/*/*.webp
  Cache-Control: public, max-age=86400

# Launch Control's car models (a day, like the art: a model can be replaced under the same name).
/games/launch-control/rg/*
  Cache-Control: public, max-age=86400

/games/launch-control/cosmo/*
  Cache-Control: public, max-age=86400

# Game photo library: files are named by their source id and never change.
/photos/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The Discord Activity (docs/discord-activity.md): Discord shows these two pages in a frame (through its
# proxy, <client id>.discordsays.com), so they let Discord frame them instead of SAMEORIGIN. Every other
# page is only reached by in-app navigation there and keeps X-Frame-Options.
/
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors 'self' https://discord.com https://*.discord.com https://*.discordsays.com

/discord
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors 'self' https://discord.com https://*.discord.com https://*.discordsays.com
