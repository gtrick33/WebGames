# Copy to .env.local for local overrides. NEVER put secret keys here:
# every VITE_* variable is embedded in the public browser bundle.

# Public site address, used for canonical URLs, Open Graph tags, share links and the sitemap.
VITE_SITE_URL=https://glitchboundstudio.com

# Analytics: "none" (production default), "console" (dev default) or "umami".
VITE_ANALYTICS=
# Umami Cloud or self-hosted Umami. The website id is public (it is in the page source anyway).
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SRC=https://cloud.umami.is/script.js

# Google AdSense display ads. The publisher id alone only writes ads.txt; VITE_ADS_ENABLED=on actually shows ads.
# Each placement also needs an ad unit (slot) id from AdSense > Ads > By ad unit.
VITE_ADSENSE_CLIENT=
VITE_ADS_ENABLED=
VITE_ADSENSE_TEST=
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_GAME=
