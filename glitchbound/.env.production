# Production build settings (committed on purpose: these values are public, never put secrets here).
VITE_SITE_URL=https://glitchboundstudio.com
# Google AdSense publisher id (same account as NEON RUSH). On its own this only publishes /ads.txt.
VITE_ADSENSE_CLIENT=ca-pub-9356777861178613
# Ads stay OFF until Google approves the site. Then set this to "on" and add slot ids (see docs/LAUNCH-GUIDE.md).
VITE_ADS_ENABLED=
# Analytics stay off until an Umami website id is added (see docs/ANALYTICS.md).
VITE_ANALYTICS=none
