# Production build settings (committed on purpose: these values are public, never put secrets here).
VITE_SITE_URL=https://glitchboundstudio.com
# Google AdSense publisher id (same account as NEON RUSH). On its own this only publishes /ads.txt.
VITE_ADSENSE_CLIENT=ca-pub-9356777861178613
# This only lets the switch in Admin > Ads & shop work: no banner shows and no Google script loads until that switch is on.
# Turn it on once Google has approved the site and the consent message is published (see docs/LEGAL-READINESS.md).
VITE_ADS_ENABLED=on
# The two AdSense ad units (public: Google's own snippet puts them in a page's code).
VITE_ADSENSE_SLOT_HOME=4798011937
VITE_ADSENSE_SLOT_GAME=5177285880
# Analytics stay off until an Umami website id is added (see docs/ANALYTICS.md).
VITE_ANALYTICS=none
# Discord Activity client ID (public). Empty keeps /discord off; see docs/discord-activity.md.
VITE_DISCORD_CLIENT_ID=
