# Copy to .env.local for local overrides. NEVER put secret keys here:
# every VITE_* variable is embedded in the public browser bundle.

# Ad provider: "none" (default in production) or "mock" (dev only; ignored in production builds).
VITE_AD_PROVIDER=none
# Purchase provider: "disabled" (default in production) or "mock" (dev only; ignored in production builds).
VITE_PURCHASE_PROVIDER=disabled

# Google H5 Games Ads. The publisher id alone only writes ads.txt; VITE_ADS_ENABLED=on actually shows ads.
# VITE_ADSENSE_TEST=on uses Google's test ads (no earnings).
VITE_ADSENSE_CLIENT=
VITE_ADS_ENABLED=
VITE_ADSENSE_TEST=

# Optional future backend (Supabase). Only the PUBLIC anon key may ever go here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
